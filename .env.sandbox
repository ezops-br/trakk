# Static sandbox env — committed on purpose (see sandbox-setup.sh header for why).
#
# Snapshot of trakk/prod/backend + trakk/prod/frontend (merged, DB_PASSWORD
# dropped) plus the fixed sandbox overrides, taken once by hand instead of
# being pulled from Secrets Manager on every sandbox boot. No live secrets
# are stored here — JWT_SECRET is a placeholder sandbox-setup.sh replaces
# with a freshly generated value on every run (same rotate-on-boot approach
# as local-setup.sh), so this file is safe to keep committed.
#
# __FRONTEND_URL__ / __BACKEND_URL__ / __COOKIE_DOMAIN__ / __JWT_SECRET__ are
# placeholders — sandbox-setup.sh fills them in at runtime (the URLs can't be
# static since every new sandbox gets a different UUID) and writes the result
# to .env (gitignored, not this file).
#
# To refresh a non-secret value after it changes in AWS:
#   export AWS_PROFILE=trakk
#   aws secretsmanager get-secret-value --secret-id trakk/prod/backend  --query SecretString --output text | jq .
#   aws secretsmanager get-secret-value --secret-id trakk/prod/frontend --query SecretString --output text | jq .
#   # then hand-edit the changed key(s) below — do not regenerate the whole file blindly,
#   # it would clobber the __PLACEHOLDER__ tokens if done via the old jq merge.
CORS_ORIGIN=__FRONTEND_URL__
DATABASE_URL=postgresql://trakk:trakk_dev@db:5432/trakk
DISABLE_APP_CORS=true
INTERNAL_API_URL=http://backend:4000/api/v1
JWT_EXPIRY=7d
JWT_SECRET=__JWT_SECRET__
NEXT_PUBLIC_API_URL=__BACKEND_URL__
NODE_ENV=production
PORT=4000
POSTGRES_DB=trakk
POSTGRES_PASSWORD=trakk_dev
POSTGRES_USER=trakk
PUBLIC_BACKEND_URL=__BACKEND_URL__
S3_BUCKET=
S3_PUBLIC_URL=
S3_REGION=us-east-1
SESSION_COOKIE_DOMAIN=__COOKIE_DOMAIN__
UPLOAD_MAX_SIZE_MB=10
