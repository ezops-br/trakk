generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  OWNER
  MEMBER
  VIEWER
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

enum LinkType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  passwordHash String  @map("password_hash")
  displayName String   @map("display_name")
  avatarUrl         String?  @map("avatar_url")
  themePreference   String   @default("light") @map("theme_preference")
  avatarStoragePath String?  @map("avatar_storage_path")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships       ProjectMember[]
  assignedTickets   Ticket[]        @relation("TicketAssignee")
  reportedTickets   Ticket[]        @relation("TicketReporter")
  comments          Comment[]
  activityLogs      ActivityLog[]
  linksCreated      TicketLink[]
  uploadedAttachments TicketAttachment[]

  @@map("users")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  key         String   @unique
  description String?
  dueDate     DateTime? @map("due_date")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members ProjectMember[]
  columns StatusColumn[]
  tickets Ticket[]
  labels  Label[]
  templates TicketTemplate[]

  @@map("projects")
}

model TicketTemplate {
  id                  String    @id @default(uuid())
  projectId           String    @map("project_id")
  name                String
  titleTemplate       String?   @map("title_template")
  descriptionTemplate String?   @map("description_template")
  defaultPriority     Priority? @map("default_priority")
  defaultLabelIds     String[]  @map("default_label_ids")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ticket_templates")
}

model ProjectMember {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  role      Role
  joinedAt  DateTime @default(now()) @map("joined_at")

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@map("project_members")
}

model StatusColumn {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@map("status_columns")
}

model Ticket {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  // Auto-incremented per project in the service layer; unique enforced below
  number         Int
  title          String
  description    String?
  statusColumnId String   @map("status_column_id")
  priority       Priority @default(NONE)
  assigneeId     String?  @map("assignee_id")
  reporterId     String   @map("reporter_id")
  dueDate        DateTime? @map("due_date")
  // Float supports fractional values for gap-based drag-and-drop reordering
  sortOrder      Float    @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statusColumn StatusColumn @relation(fields: [statusColumnId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  reporter     User         @relation("TicketReporter", fields: [reporterId], references: [id])
  labels       TicketLabel[]
  comments     Comment[]
  activityLogs ActivityLog[]
  sourceLinks  TicketLink[] @relation("SourceLinks")
  targetLinks  TicketLink[] @relation("TargetLinks")
  attachments  TicketAttachment[]

  @@unique([projectId, number])
  @@index([projectId])
  @@index([assigneeId])
  @@index([statusColumnId])
  @@index([projectId, statusColumnId])
  @@index([projectId, dueDate])
  @@map("tickets")
}

model Label {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  color     String
  createdAt DateTime @default(now()) @map("created_at")

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets TicketLabel[]

  @@map("labels")
}

model TicketLabel {
  ticketId String @map("ticket_id")
  labelId  String @map("label_id")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  label  Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([ticketId, labelId])
  @@map("ticket_labels")
}

model Comment {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("comments")
}

model TicketLink {
  id              String   @id @default(uuid())
  sourceTicketId  String   @map("source_ticket_id")
  targetTicketId  String   @map("target_ticket_id")
  type            LinkType
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  sourceTicket Ticket @relation("SourceLinks", fields: [sourceTicketId], references: [id], onDelete: Cascade)
  targetTicket Ticket @relation("TargetLinks", fields: [targetTicketId], references: [id], onDelete: Cascade)
  createdBy    User   @relation(fields: [createdByUserId], references: [id])

  @@index([sourceTicketId])
  @@index([targetTicketId])
  @@map("ticket_links")
}

model ActivityLog {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  userId    String   @map("user_id")
  action    String
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([ticketId, createdAt(sort: Desc)])
  @@map("activity_logs")
}

model TicketAttachment {
  id           String   @id @default(uuid())
  ticketId     String   @map("ticket_id")
  uploaderId   String   @map("uploader_id")
  /// Bytes payload. Nullable because legacy rows from the pre-bytea S3 era (PR #39)
  /// have bytes = NULL; the raw route returns 404 for those rows. No backfill — by
  /// design, those rows are unrecoverable.
  bytes        Bytes?   @map("bytes")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  createdAt    DateTime @default(now()) @map("created_at")

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploaderId], references: [id])

  @@index([ticketId])
  @@map("ticket_attachments")
}
