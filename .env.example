# Database
# The db service needs POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB
POSTGRES_USER=trakk
# Strong random password for PostgreSQL
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=trakk
# Full connection string — substitutes POSTGRES_PASSWORD above
DATABASE_URL=postgresql://trakk:${POSTGRES_PASSWORD}@db:5432/trakk

# Auth (Trakk session)
# 64-character random string used to sign JWTs
JWT_SECRET=<64-char-random-string>
# JWT lifetime (e.g. 7d, 24h)
JWT_EXPIRY=7d

# Google OAuth 2.0
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=<from-google-cloud-console>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<from-google-cloud-console>
# Must match an authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Token encryption (for storing Google refresh tokens at rest)
# Must be a 32-byte hex string (64 hex chars), never commit this value
TOKEN_ENCRYPTION_KEY=<32-byte-hex-string>

# API
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Frontend
# Public URL used by browser → API calls from client components
# Bare origin only — frontend code appends /api/v1/... paths explicitly
NEXT_PUBLIC_API_URL=http://localhost:4000
# Internal URL used by Next.js server components (Docker service name resolution)
INTERNAL_API_URL=http://backend:4000/api/v1
# Same value as GOOGLE_CLIENT_ID — exposed to the browser for Google Sign-In button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<same-as-GOOGLE_CLIENT_ID>

# Email (optional in dev — used for notifications, not auth)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<email>
SMTP_PASS=<password>
SMTP_FROM=noreply@trakk.dev

# File uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_STORAGE_PATH=/app/uploads

# S3-compatible avatar storage (optional — leave blank to use local disk in dev)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Full public base URL for avatar URLs (e.g. https://my-bucket.s3.amazonaws.com)
# Leave blank if serving avatars via backend static route
S3_PUBLIC_URL=
