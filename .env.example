# Database — read directly by the `db` (Postgres) container, and substituted
# into DATABASE_URL below. trakk_dev is fine for local dev; use a real
# random password for anything shared or long-lived.
POSTGRES_USER=trakk
POSTGRES_PASSWORD=trakk_dev
POSTGRES_DB=trakk
# Full connection string — substitutes POSTGRES_PASSWORD above
DATABASE_URL=postgresql://trakk:${POSTGRES_PASSWORD}@db:5432/trakk

# Auth (Trakk session)
# 64-character random string used to sign JWTs
JWT_SECRET=<64-char-random-string>
# JWT lifetime (e.g. 7d, 24h)
JWT_EXPIRY=7d

# API
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Frontend
# Public URL used by browser → API calls from client components
# Bare origin only — frontend code appends /api/v1/... paths explicitly
NEXT_PUBLIC_API_URL=http://localhost
# Internal URL used by Next.js server components (Docker service name resolution)
INTERNAL_API_URL=http://backend:4000/api/v1

# S3-compatible avatar storage (optional — leave blank to use local disk in dev)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Full public base URL for avatar URLs (e.g. https://my-bucket.s3.amazonaws.com)
# Leave blank if serving avatars via backend static route
S3_PUBLIC_URL=
# Local disk avatar directory (only used when S3_BUCKET is blank).
# Optional — defaults to ./uploads/avatars if unset.
AVATAR_UPLOAD_DIR=
