# Stage 1: deps
FROM node:20-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

# Stage 2: builder
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN npm run build

# Stage 3: runner
FROM node:20-alpine AS runner
RUN addgroup --system --gid 1001 trakk && \
    adduser --system --uid 1001 --ingroup trakk trakk
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
COPY --from=builder --chown=trakk:trakk /app/.next/standalone ./
COPY --from=builder --chown=trakk:trakk /app/.next/static ./.next/static
COPY --from=builder --chown=trakk:trakk /app/public ./public
USER trakk
EXPOSE 3000
CMD ["node", "server.js"]
